# Dominio donde se servirá el panel (registro A/AAAA apuntando al VPS).
# Sin dominio propio puedes usar sslip.io: vhub.<IP-del-VPS>.sslip.io
VHUB_DOMAIN=vhub.tudominio.com

# --- Todo lo de abajo es OPCIONAL ---
# Si lo dejas vacío, el asistente web te lo pide en el primer arranque y lo guarda cifrado.
# Si lo defines aquí, tiene prioridad y no se puede cambiar desde el panel.

# Acceso al panel
ADMIN_USER=
ADMIN_PASSWORD=

# Clave para firmar sesiones y cifrar lo guardado. Si no la defines se genera una
# y se guarda en el volumen de datos. Para fijarla: openssl rand -hex 32
APP_SECRET=

# Coolify. Desde el mismo VPS se accede por la red interna: http://coolify:8080
# Token: Coolify -> Keys & Tokens -> API tokens, con permiso "root"
# (o "read" + "write" + "deploy" + "read:sensitive"; sin read:sensitive no se ven las URLs de las BD).
COOLIFY_URL=
COOLIFY_TOKEN=

# internal: conecta a las BD por la red docker (recomendado en el VPS)
# external: usa la URL pública de cada BD (útil desarrollando en local)
COOLIFY_DB_ACCESS=
