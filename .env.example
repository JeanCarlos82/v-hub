# Dominio donde se servirá el panel (apunta un registro A/AAAA al VPS)
VHUB_DOMAIN=vhub.tudominio.com

# Acceso al panel
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esto-por-una-contraseña-larga

# Clave para firmar sesiones y cifrar credenciales guardadas.
# Opcional: si no la defines se genera una y se guarda en el volumen de datos.
# Genera una con: openssl rand -hex 32
APP_SECRET=

# Coolify: desde el mismo VPS se accede por la red interna "coolify".
# Token: Coolify -> Keys & Tokens -> API tokens, con permiso "root"
# (o "read" + "write" + "deploy" + "read:sensitive"; sin read:sensitive no se ven las URLs de las BD).
COOLIFY_URL=http://coolify:8080
COOLIFY_TOKEN=

# internal: conecta a las BD por la red docker (recomendado en el VPS)
# external: usa la URL pública de cada BD (útil desarrollando en local)
COOLIFY_DB_ACCESS=internal
